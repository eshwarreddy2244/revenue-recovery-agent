# Copy this file to .env and fill in your own TEST MODE credentials.
# Never commit your real .env file.
#
# IMPORTANT: the app only checks whether these two are SET, not
# whether they're real. If you leave the placeholder values below
# as-is, the app will attempt real Razorpay API calls with fake
# credentials -- they'll fail with "Authentication failed" (caught
# and logged, never crashes the batch, just noisy). If you don't
# have real TEST-mode keys yet, delete the two lines below (or leave
# their values blank) to get the quiet simulated-link fallback instead.

# Razorpay TEST MODE keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Groq API key — optional. Only used for parsing ambiguous free-text
# failure descriptions and for generating Hinglish customer-facing
# copy for the dispute-halt demo. Never used in diagnose.py,
# policy_gate.py, or sequencer.py. Leave blank for the safe templated
# fallback instead of a real LLM call.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
